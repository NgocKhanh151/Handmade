---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Xưởng Thủ Công — Sản phẩm làm tay theo yêu cầu',
  description = 'Trưng bày sản phẩm thủ công tinh xảo. Đặt làm theo kích thước, màu sắc và chất liệu riêng qua Zalo hoặc Messenger.',
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    ></script>
  </head>
  <body class="bg-cream text-ink antialiased min-h-screen flex flex-col">
    <slot />
  </body>
</html>
